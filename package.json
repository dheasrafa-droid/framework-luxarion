{
  "name": "framework-luxarion",
  "version": "1.0.0",
  "description": "Lightweight, zero-dependency 2D & 3D WebGL / Canvas graphics engine with CDN & NPM support.",
  "type": "module",
  "main": "./dist/luxarion.umd.js",
  "module": "./dist/luxarion.es.js",
  "types": "./src/index.ts",
  "unpkg": "./dist/luxarion.umd.js",
  "jsdelivr": "./dist/luxarion.umd.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/luxarion.es.js",
      "require": "./dist/luxarion.umd.js"
    }
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:cdn": "vite build --config vite.config.lib.ts",
    "build:lib": "vite build --config vite.config.lib.ts",
    "build:all": "vite build && vite build --config vite.config.lib.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
